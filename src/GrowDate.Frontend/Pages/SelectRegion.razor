@page "/select-region"
@using GrowDate.Frontend.Services
@using GrowDate.Core.DTOs
@using Microsoft.JSInterop
@inject ApiService ApiService
@inject RegionStateService RegionState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Select Region</PageTitle>

<div class="region-selector">
    <h1>Select Your Region</h1>
    <p>Choose your location on the map or from the list below</p>

    @if (loading)
    {
        <div class="loading compact">
            <div class="spinner"></div>
            <p>Loading regions...</p>
        </div>
    }

    <div class="map-wrapper">
        <div id="map-container" class="map-container"></div>
    </div>

    @if (!regions.Any() && !loading)
    {
        <div class="alert">
            <p>No regions available. Start the API at <code>http://localhost:5100</code> and refresh.</p>
        </div>
    }
    else if (regions.Any())
    {
        <div class="region-grid">
            @foreach (var region in regions)
            {
                <div class="region-card @(selectedRegion?.Id == region.Id ? "selected" : "")"
                     @onclick="() => OnSelectRegion(region)">
                    <h3>@region.Name</h3>
                    <p><strong>Country:</strong> @region.Country</p>
                    <p><strong>Climate Zone:</strong> @region.ClimateZone</p>
                    <p><strong>Coordinates:</strong> @region.Latitude.ToString("F2"), @region.Longitude.ToString("F2")</p>
                    @if (selectedRegion?.Id == region.Id)
                    {
                        <div class="selected-indicator">Selected</div>
                    }
                </div>
            }
        </div>

        @if (selectedRegion != null)
        {
            <div class="action-buttons">
                <button class="btn" @onclick="ViewCalendar">View Calendar</button>
                <button class="btn" @onclick="ViewRecommendations">View Recommendations</button>
            </div>
        }
    }
</div>

@code {
    private List<RegionDto> regions = new();
    private RegionDto? selectedRegion;
    private bool loading = true;
    private DotNetObjectReference<SelectRegion>? dotNetReference;

    protected override async Task OnInitializedAsync()
    {
        await RegionState.EnsureLoadedAsync();
        selectedRegion = RegionState.GetRegion();
        regions = await ApiService.GetRegionsAsync();
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            dotNetReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("setBlazorReference", dotNetReference);
            await JS.InvokeVoidAsync("loadInteractiveMap", regions);
        }
        catch (JSException)
        {
            // Map script may not be present during prerender or tests.
        }
    }

    [JSInvokable]
    public void OnRegionSelected(int regionId)
    {
        var region = regions.FirstOrDefault(r => r.Id == regionId);
        if (region != null)
        {
            OnSelectRegion(region);
            StateHasChanged();
        }
    }

    private void OnSelectRegion(RegionDto region)
    {
        selectedRegion = region;
        RegionState.SetRegion(region);
    }

    private void ViewCalendar() => Navigation.NavigateTo("/calendar");

    private void ViewRecommendations() => Navigation.NavigateTo("/recommendations");

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("disposeMap");
        }
        catch (JSException)
        {
        }

        dotNetReference?.Dispose();
    }
}
