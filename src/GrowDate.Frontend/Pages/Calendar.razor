@page "/calendar"
@using GrowDate.Frontend.Services
@using GrowDate.Core.DTOs
@using GrowDate.Core.Services
@inject ApiService ApiService
@inject RegionStateService RegionState

<PageTitle>Planting Calendar</PageTitle>

<div class="calendar-container">
    <p class="kicker">In the ground</p>
    <h1 class="page-title">Planting calendar</h1>

    @if (selectedRegion == null)
    {
        <div class="alert">
            <p>Please <a href="select-region">select a region</a> first to see planting days.</p>
        </div>
    }
    else
    {
        <p class="region-meta">Showing <strong>@selectedRegion.Name</strong></p>

        <div class="calendar-header">
            <button class="btn btn-ghost" @onclick="PreviousMonth">Previous</button>
            <h2>@currentDate.ToString("MMMM yyyy")</h2>
            <button class="btn btn-ghost" @onclick="NextMonth">Next</button>
        </div>

        <div class="calendar-grid">
            @foreach (var day in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
            {
                <div class="calendar-day-header">@day</div>
            }

            @foreach (var day in GetCalendarDays())
            {
                <div class="calendar-day @GetDayClass(day)" @onclick="() => SelectDate(day)">
                    <div class="day-number">@day.Day</div>
                    @if (day.Month == currentDate.Month && plantingDays.Contains(day.Day))
                    {
                        <div class="planting-indicator" aria-hidden="true"></div>
                    }
                </div>
            }
        </div>

        @if (!selectedDate.HasValue)
        {
            <div class="alert">
                <p>Pick a dotted day to see what can go in the ground.</p>
            </div>
        }
        else if (!recommendations.Any())
        {
            <div class="alert">
                <p>Nothing listed for @selectedDate.Value.ToString("MMMM dd, yyyy"). Try a day with a green dot.</p>
            </div>
        }
        else
        {
            <div class="selected-date-info">
                <h3>Crops for @selectedDate.Value.ToString("MMMM dd, yyyy")</h3>
                <div class="recommendation-list">
                    @foreach (var rec in recommendations.OrderByDescending(r => r.IsIdealTime))
                    {
                        <a class="recommendation-card @StatusClass(rec.Status)" href="@($"plants/{rec.Crop.Id}")">
                            <div class="crop-header">
                                <CropThumb Crop="rec.Crop" Size="56" />
                                <span class="crop-name">@rec.Crop.Name</span>
                                <span class="status-badge @StatusClass(rec.Status)">@rec.Status</span>
                            </div>
                            <p>@rec.Notes</p>
                            <div class="crop-details">
                                <div class="detail-item">
                                    <span class="detail-label">Germination</span>
                                    <span class="detail-value">@rec.EstimatedGerminationDate.ToString("MMM dd")</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">@rec.Crop.HarvestOrBloomLabel</span>
                                    <span class="detail-value">@rec.EstimatedHarvestDate.ToString("MMM dd")</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private RegionDto? selectedRegion;
    private DateTime currentDate = DateTime.Now;
    private DateTime? selectedDate;
    private List<RecommendationDto> recommendations = new();
    private HashSet<int> plantingDays = new();
    private List<CropDto> regionCrops = new();

    protected override async Task OnInitializedAsync()
    {
        await RegionState.EnsureLoadedAsync();
        selectedRegion = RegionState.GetRegion();
        if (selectedRegion != null)
        {
            regionCrops = await ApiService.GetCropsForRegionAsync(selectedRegion.Id);
            LoadPlantingDays();
        }
    }

    private void LoadPlantingDays()
    {
        if (selectedRegion == null) return;

        var startDate = new DateTime(currentDate.Year, currentDate.Month, 1);
        var endDate = startDate.AddMonths(1).AddDays(-1);
        plantingDays.Clear();

        foreach (var crop in regionCrops)
        {
            for (var date = startDate; date <= endDate; date = date.AddDays(1))
            {
                var (plantingStart, plantingEnd) = PlantingWindowCalculator.GetWindow(
                    crop.PlantingStartMonth, crop.PlantingStartDay,
                    crop.PlantingEndMonth, crop.PlantingEndDay,
                    selectedRegion.Latitude, date);

                if (date >= plantingStart && date <= plantingEnd)
                    plantingDays.Add(date.Day);
            }
        }
    }

    private List<DateTime> GetCalendarDays()
    {
        var firstDay = new DateTime(currentDate.Year, currentDate.Month, 1);
        var lastDay = firstDay.AddMonths(1).AddDays(-1);
        var startDay = firstDay.AddDays(-(int)firstDay.DayOfWeek);
        var endDay = lastDay.AddDays(6 - (int)lastDay.DayOfWeek);

        var days = new List<DateTime>();
        for (var date = startDay; date <= endDay; date = date.AddDays(1))
            days.Add(date);
        return days;
    }

    private string GetDayClass(DateTime day)
    {
        var classes = new List<string>();

        if (day.Month != currentDate.Month)
            classes.Add("other-month");

        if (selectedDate.HasValue && day.Date == selectedDate.Value.Date)
            classes.Add("selected");

        if (day.Month == currentDate.Month && plantingDays.Contains(day.Day))
            classes.Add("has-planting");

        return string.Join(" ", classes);
    }

    private static string StatusClass(string status) =>
        status.ToLowerInvariant().Replace(" ", "-");

    private async Task SelectDate(DateTime date)
    {
        selectedDate = date;
        if (selectedRegion != null)
            recommendations = await ApiService.GetRecommendationsAsync(selectedRegion.Id, date);
    }

    private Task PreviousMonth()
    {
        currentDate = currentDate.AddMonths(-1);
        selectedDate = null;
        recommendations.Clear();
        LoadPlantingDays();
        return Task.CompletedTask;
    }

    private Task NextMonth()
    {
        currentDate = currentDate.AddMonths(1);
        selectedDate = null;
        recommendations.Clear();
        LoadPlantingDays();
        return Task.CompletedTask;
    }
}
