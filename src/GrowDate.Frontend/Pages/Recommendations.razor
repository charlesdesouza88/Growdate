@page "/recommendations"
@inject ApiService ApiService
@inject RegionStateService RegionState

<PageTitle>In season</PageTitle>

<div class="recommendations-container">
    <p class="kicker">What to plant</p>
    <h1 class="page-title">In season</h1>

    @if (selectedRegion == null)
    {
        <div class="alert">
            <p>Please <a href="select-region">select a region</a> first to see recommendations.</p>
        </div>
    }
    else
    {
        <div class="filter-section">
            <div>
                <label>Region: <strong>@selectedRegion.Name</strong></label>
                <a href="select-region" class="btn btn-ghost">Change region</a>
            </div>
            <div>
                <label for="dateSelect">Select Date:</label>
                <input id="dateSelect" type="date" @bind="selectedDate" @bind:after="LoadRecommendations" />
            </div>
        </div>

        @if (loading)
        {
            <div class="loading compact">
                <div class="spinner"></div>
                <p>Loading recommendations...</p>
            </div>
        }
        else if (!recommendations.Any())
        {
            <div class="alert">
                <p>No recommendations available for this date and region.</p>
            </div>
        }
        else
        {
            <div class="summary">
                <h2>Recommendations for @selectedDate.ToString("MMMM dd, yyyy")</h2>
                <p>Found @recommendations.Count crops suitable for your region</p>
            </div>

            <div class="chip-row">
                <button type="button" class="chip @(statusFilter == null ? "active" : "")" @onclick="() => statusFilter = null">All</button>
                @foreach (var status in Statuses)
                {
                    <button type="button" class="chip @(statusFilter == status ? "active" : "")"
                            @onclick="() => statusFilter = status">@status</button>
                }
            </div>

            <div class="recommendation-list">
                @foreach (var rec in Visible)
                {
                    <div class="recommendation-card @StatusClass(rec.Status)">
                        <div class="crop-header">
                            <CropThumb Crop="rec.Crop" Size="56" />
                            <a class="crop-name" href="@($"plants/{rec.Crop.Id}")">@rec.Crop.Name</a>
                            <span class="status-badge @StatusClass(rec.Status)">@rec.Status</span>
                        </div>

                        <div class="crop-category">
                            <span>@rec.Crop.Category · @rec.Crop.SunRequirement · @rec.Crop.WaterRequirement water</span>
                        </div>

                        <details class="crop-fold">
                            <summary>Dates and notes</summary>
                            <div class="crop-details">
                                <div class="detail-item">
                                    <span class="detail-label">Planting window</span>
                                    <span class="detail-value">
                                        @rec.PlantingWindowStart.ToString("MMM dd") - @rec.PlantingWindowEnd.ToString("MMM dd")
                                    </span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Germination</span>
                                    <span class="detail-value">@rec.EstimatedGerminationDate.ToString("MMM dd, yyyy")</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">@rec.Crop.HarvestOrBloomLabel</span>
                                    <span class="detail-value">@rec.EstimatedHarvestDate.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                            <div class="notes">
                                <p>@rec.Notes</p>
                            </div>
                        </details>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private static readonly string[] Statuses = { "Ideal", "Coming Soon", "Late Season", "Out of Season" };

    private RegionDto? selectedRegion;
    private DateTime selectedDate = DateTime.Now;
    private List<RecommendationDto> recommendations = new();
    private string? statusFilter;
    private bool loading;

    private IEnumerable<RecommendationDto> Visible =>
        recommendations
            .Where(r => statusFilter == null || r.Status == statusFilter)
            .OrderByDescending(r => r.IsIdealTime)
            .ThenBy(r => r.Crop.Name);

    protected override async Task OnInitializedAsync()
    {
        await RegionState.EnsureLoadedAsync();
        selectedRegion = RegionState.GetRegion();
        if (selectedRegion != null)
            await LoadRecommendations();
    }

    private async Task LoadRecommendations()
    {
        if (selectedRegion == null) return;

        loading = true;
        try
        {
            recommendations = await ApiService.GetRecommendationsAsync(selectedRegion.Id, selectedDate);
        }
        catch (Exception)
        {
            recommendations.Clear();
        }
        finally
        {
            loading = false;
        }
    }

    private static string StatusClass(string status) =>
        status.ToLowerInvariant().Replace(" ", "-");
}
