@inherits LayoutComponentBase
@implements IDisposable
@inject RegionStateService RegionState

<div class="page">
    <aside class="sidebar">
        <a class="brand" href="">GrowDate</a>
        @if (region != null)
        {
            <a class="region-chip" href="select-region">@region.Name</a>
        }
        <NavMenu />
    </aside>

    <main>
        <article>
            @Body
        </article>
    </main>
</div>

@code {
    private RegionDto? region;

    protected override async Task OnInitializedAsync()
    {
        RegionState.Changed += OnRegionChanged;
        await RegionState.EnsureLoadedAsync();
        region = RegionState.GetRegion();
    }

    private void OnRegionChanged()
    {
        region = RegionState.GetRegion();
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        RegionState.Changed -= OnRegionChanged;
    }
}
